# Copy this file to .env in the project root. Never commit .env.
# Only VITE_ variables are visible to the browser. Never prefix the portal password with VITE_.

# How long one browser desktop stays open, in milliseconds. 1800000 is 30 minutes.
SESSION_TIMEOUT_MS=1800000

# Virtual display used by Chromium, x11vnc, and noVNC inside Docker.
DISPLAY=:99
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800
VNC_PORT=5900
NOVNC_PORT=6080
NOVNC_WEB=/opt/noVNC

# Address the website loads in the iframe. It must not contain a token or password.
VIEWER_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale&reconnect=1&path=websockify

# test opens a public page and stops. portal submits only the configured login form.
IHX_LOGIN_MODE=test

# Public page used until real IHX selectors are provided. Must be http or https.
TEST_PAGE_URL=https://httpbin.org/forms/post

# Required only when IHX_LOGIN_MODE=portal.
IHX_PORTAL_URL=
IHX_USERNAME=
IHX_PASSWORD=
IHX_USERNAME_SELECTOR=
IHX_PASSWORD_SELECTOR=
IHX_SUBMIT_SELECTOR=
IHX_SUCCESS_SELECTOR=
# Optional. When this element appears, the doctor completes verification in the live browser.
IHX_VERIFICATION_SELECTOR=

# Optional shared key for the PoC API. Required if HOST is not a local address.
# The frontend only sees this if you also set VITE_APP_API_KEY to the same value.
APP_API_KEY=
VITE_APP_API_KEY=

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3001

# Inside Docker Compose this is overridden to 0.0.0.0, and the published ports stay on 127.0.0.1.
HOST=127.0.0.1
PORT=3001
MAX_ACTIVE_SESSIONS=1

# Set by the Docker image to the built website. Leave empty for local Vite development.
STATIC_DIR=
