# Copy this file to .env in the project root. Never commit .env.
# Only VITE_ variables are visible to the browser. Never prefix the Browserless token or portal password with VITE_.

# Browserless account token from the dashboard. Server-side only.
# Put the token here. Do not put it in frontend code or in Vite variables.
BROWSERLESS_TOKEN=

# Documented regional host. Closest options:
# production-sfo.browserless.io, production-lon.browserless.io, production-ams.browserless.io
BROWSERLESS_HOST=production-sfo.browserless.io

# Uses the documented /chromium/stealth route. Turn this on for the IHX portal.
BROWSERLESS_STEALTH=true

# residential keeps the browser on a normal household IP. datacenter is faster but portals often block it.
# in routes the browser through India, next to the IHX portal.
BROWSERLESS_PROXY=residential
BROWSERLESS_PROXY_COUNTRY=in

# Absolute browser lifetime in milliseconds, sent as the documented timeout launch parameter.
# This must be within the Browserless plan maximum or the session is rejected:
# Free 120000, Prototyping 900000, Starter 1800000, Scale 3600000.
SESSION_TIMEOUT_MS=120000

# test opens a public page and stops. portal submits only the configured login form.
IHX_LOGIN_MODE=test

# Public page used until real IHX selectors are provided. Must be http or https.
TEST_PAGE_URL=https://httpbin.org/forms/post

# Required only when IHX_LOGIN_MODE=portal. Leave blank until the real portal is known.
IHX_PORTAL_URL=
IHX_USERNAME=
IHX_PASSWORD=
IHX_USERNAME_SELECTOR=
IHX_PASSWORD_SELECTOR=
IHX_SUBMIT_SELECTOR=
IHX_SUCCESS_SELECTOR=
# Optional. When this element appears, the doctor completes verification in the live browser.
IHX_VERIFICATION_SELECTOR=

# Optional shared key for the PoC API. Required if HOST is not localhost.
# The frontend only sees this if you also set VITE_APP_API_KEY to the same value.
APP_API_KEY=
VITE_APP_API_KEY=

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=127.0.0.1
PORT=3001
MAX_ACTIVE_SESSIONS=1
