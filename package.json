{
  "name": "ihxflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "start:backend": "npm run start -w backend",
    "check": "npm run check -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
